              "name": "cross-doc conflict",
              "shortDescription": {
                "text": "same subject, conflicting values across docs"
              }
            },
            {
              "id": "R4",
              "name": "missing supersedes/deprecation",
              "shortDescription": {
                "text": "newer artifact contradicts an unmarked claim"
              }
            },
